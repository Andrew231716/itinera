# Server-side Google Maps Platform key (Places + Routes). Never expose to the browser.
GOOGLE_MAPS_API_KEY=

# Optional alias if you use a dedicated Routes key
# GOOGLE_ROUTES_API_KEY=

# Browser-restricted key for Maps JavaScript API (HTTP referrer restrictions recommended)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Phase 6 — Natural language assistant
OPENAI_API_KEY=

# Phase 5 — Supabase persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
