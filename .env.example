# =============================================================================
# Itinera — variabili d'ambiente
# Copia in .env.local per lo sviluppo. Su Vercel: Settings → Environment Variables
# (vedi DEPLOY_VERCEL.md). Mai committare .env.local o valori reali.
# =============================================================================

# --- Google Maps (obbligatorie per modalità live) ---

# Server-side Google Maps Platform key (Places + Routes). Never expose to the browser.
GOOGLE_MAPS_API_KEY=

# Optional alias if you use a dedicated Routes key
# GOOGLE_ROUTES_API_KEY=

# Browser-restricted key for Maps JavaScript API (HTTP referrer restrictions recommended)
# Su Vercel aggiungi https://<progetto>.vercel.app/* (e custom domain) ai referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional routing engine id: google_routes (default) | openrouteservice
# ROUTING_ENGINE=google_routes

# Optional — adapter predisposto, non attivo finché non implementato end-to-end
# OPENROUTESERVICE_API_KEY=

# --- Assistente IA (opzionale; utenti finali NON incollano chiavi) ---

# Gemini gratuito: di default riusa GOOGLE_MAPS_API_KEY (stesso progetto Cloud).
# Serve solo abilitare Generative Language API sul progetto (itinera-509522):
# https://console.developers.google.com/apis/api/generativelanguage.googleapis.com/overview?project=itinera-509522
# Se la chiave server ha «API restrictions», aggiungi anche Generative Language API.
# Login Google nell’app NON sblocca Gemini da solo.
#
# Chiave dedicata opzionale (AI Studio), altrimenti si usa la Maps server key:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GOOGLE_AI_API_KEY=

# OpenAI — fallback a pagamento (credit esaurito non blocca il deploy)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Ordine provider: auto (default) | gemini | openai
# AI_PROVIDER=auto

# --- Supabase (opzionale; senza di esso resta localStorage) ---

# Supabase persistence (anon key only in browser / server anon client)
# Da Project Settings → API dopo aver eseguito supabase/migrations/001_itinera_trips.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put service role in NEXT_PUBLIC_*. Optional server-only for advanced ops.
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Checklist Vercel (Production + Preview consigliato)
# 1. GOOGLE_MAPS_API_KEY
# 2. NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY
# 3. NEXT_PUBLIC_SUPABASE_URL
# 4. NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Assistente: abilita Generative Language API sul progetto Maps (riusa GOOGLE_MAPS_API_KEY)
#    oppure GEMINI_API_KEY dedicata / OPENAI_API_KEY
# Dopo aver cambiato NEXT_PUBLIC_*: Redeploy obbligatorio.
# Poi aggiorna i referrer HTTP della browser key Google col dominio Vercel.
# Guida completa: DEPLOY_VERCEL.md
# =============================================================================
